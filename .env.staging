# Staging Environment Configuration
# This file is used during the staging build process

# Gemini API Configuration
VITE_GEMINI_API_KEY=your_staging_gemini_api_key_here

# API Configuration
VITE_API_BASE_URL=https://staging-api.yourdomain.com

# Application Configuration
VITE_APP_NAME=Sugarcane Loss Assessment (Staging)
VITE_APP_VERSION=1.0.0-staging
VITE_ENVIRONMENT=staging

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Mapbox Configuration (if needed)
VITE_MAPBOX_TOKEN=your_staging_mapbox_token_here

# Build Configuration
VITE_BUILD_TIME=true
VITE_SOURCE_MAP=true
