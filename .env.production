# Production Environment Configuration
# This file is used during the production build process
# Do not commit sensitive data here

# Gemini API Configuration
VITE_GEMINI_API_KEY=your_production_gemini_api_key_here

# API Configuration
VITE_API_BASE_URL=https://api.yourdomain.com

# Application Configuration
VITE_APP_NAME=Sugarcane Loss Assessment
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Mapbox Configuration (if needed)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Build Configuration
VITE_BUILD_TIME=true
VITE_SOURCE_MAP=false
